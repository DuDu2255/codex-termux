#!/system/bin/sh
set -eu
: "${CODEX_APP_FILES:?Missing app files directory}"
: "${CODEX_NATIVE_DIR:?Missing native library directory}"
export PROOT_TMP_DIR="$CODEX_APP_FILES/usr/tmp"
export PROOT_LOADER="$CODEX_NATIVE_DIR/libproot-loader.so"
export PROOT_NO_SECCOMP=1
export LD_LIBRARY_PATH="$CODEX_NATIVE_DIR"
unset LD_PRELOAD
command=$1
shift
case "$command" in
    "$CODEX_APP_FILES"/*) command="/data/data/com.termux/files/${command#"$CODEX_APP_FILES"/}" ;;
esac
guest_cwd=${PWD:-/data/data/com.termux/files/home}
case "$guest_cwd" in
    "$CODEX_APP_FILES"/*) guest_cwd="/data/data/com.termux/files/${guest_cwd#"$CODEX_APP_FILES"/}" ;;
esac
exec "$CODEX_NATIVE_DIR/libproot.so" --kill-on-exit \
    -b "$CODEX_APP_FILES:/data/data/com.termux/files" \
    -b "$CODEX_APP_FILES:/data/user/0/com.termux/files" \
    -w "$guest_cwd" \
    /system/bin/sh /data/data/com.termux/files/usr/libexec/codex-guest "$command" "$@"
