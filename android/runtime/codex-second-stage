#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
bash "$PREFIX/etc/termux/bootstrap/termux-bootstrap-original.sh"
# All package dependencies are bundled and checksummed at build time.
# dpkg records them normally, so subsequent pkg install/upgrade works. No apt
# resolver or network index is needed when installing the complete locked set.
dpkg --force-confold --install "$PREFIX"/opt/codex-debs/*.deb
mkdir -p "$HOME/.termux"
if [ ! -e "$HOME/.termux/termux.properties" ]; then
    printf '%s\n' "extra-keys = [['ESC','/','-','HOME','UP','END','PGUP'],['TAB','CTRL','ALT','LEFT','DOWN','RIGHT','PGDN']]" \
        > "$HOME/.termux/termux.properties"
fi
